{
  "name": "ciphervote",
  "version": "0.1.0",
  "description": "CipherVote: Shielded Anonymous DAO Voting Protocol on Midnight Network",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "compile": "node scripts/compile-compact.mjs",
    "test": "node --test test/*.test.js && node scripts/test-runner.mjs",
    "deploy:preprod": "node scripts/deploy.mjs preprod",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:local": "node scripts/deploy.mjs local",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "^4.1.1",
    "@midnight-ntwrk/testkit-js": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "midnight-network",
    "compact",
    "zero-knowledge",
    "privacy",
    "zk-snark",
    "dao-governance",
    "anonymous-voting"
